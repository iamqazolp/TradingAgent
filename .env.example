# ==============================================================================
# Technical Analysis Agent (.env) Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Market Data Feeds (Single or Dual Source)
# ------------------------------------------------------------------------------
# Option A: Local Standalone Mock Server (Testing & Development)
# Run: uv run python scripts/run_mock_api.py --port 8765 --token mock_secret
TA_AGENT_MARKET_API_URL=http://127.0.0.1:8765/api/market_bars
TA_AGENT_MARKET_API_TOKEN=mock_secret
TA_AGENT_MARKET_API_PARAMS=

TA_AGENT_FOREIGN_API_URL=http://127.0.0.1:8765/api/foreign_flow
TA_AGENT_FOREIGN_API_TOKEN=mock_secret
TA_AGENT_FOREIGN_API_PARAMS=

# Option B: Real Live Production Feeds
# Set these when switching to live broker/feed endpoints:
# TA_AGENT_MARKET_API_URL=https://api.yourbroker.com/v1/market_data
# TA_AGENT_MARKET_API_TOKEN=your_real_market_token
# TA_AGENT_FOREIGN_API_URL=https://api.yourbroker.com/v1/foreign_flow
# TA_AGENT_FOREIGN_API_TOKEN=your_real_foreign_token

# ------------------------------------------------------------------------------
# 2. Local Storage & Logging
# ------------------------------------------------------------------------------
# SQLite database path (defaults to var/ta.sqlite)
TA_AGENT_DB=var/ta.sqlite

# MCP tool call audit log (defaults to logs/tool_calls.jsonl)
TA_AGENT_AUDIT_LOG=logs/tool_calls.jsonl

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
TA_AGENT_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Local Ollama Model Configuration (Offline OpenHarness Execution)
# ------------------------------------------------------------------------------
# For local Ollama:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# 4. Optional Cloud LLM Provider API Keys
# ------------------------------------------------------------------------------
# If not using Ollama, set your chosen cloud provider key:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
