# ==============================================================================
# Technical Analysis Agent (.env) Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Market Data Feeds (Single or Dual Source)
# ------------------------------------------------------------------------------
# Option A: Single Unified Feed (provides both OHLC and foreign data)
TA_AGENT_API_URL=https://example.com/api/GetTradingStatistics
TA_AGENT_API_TOKEN=your_token_here
TA_AGENT_API_PARAMS=

# Option B: Dual Source Setup
# Source 2: Market OHLC + Order Flow (hourly/daily resolution)
TA_AGENT_MARKET_API_URL=
TA_AGENT_MARKET_API_TOKEN=
TA_AGENT_MARKET_API_PARAMS=

# Source 1: Foreign Flow & Room Statistics (daily resolution)
TA_AGENT_FOREIGN_API_URL=
TA_AGENT_FOREIGN_API_TOKEN=
TA_AGENT_FOREIGN_API_PARAMS=

# ------------------------------------------------------------------------------
# 2. Local Storage & Logging
# ------------------------------------------------------------------------------
# SQLite database path (defaults to var/ta.sqlite)
TA_AGENT_DB=var/ta.sqlite

# MCP tool call audit log (defaults to logs/tool_calls.jsonl)
TA_AGENT_AUDIT_LOG=logs/tool_calls.jsonl

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
TA_AGENT_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. LLM Provider API Keys (OpenHarness Agent Execution)
# ------------------------------------------------------------------------------
# Set the API key for your chosen provider:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenHarness configuration directory override
OPENHARNESS_CONFIG_DIR=
